---
interface Props {
	stat: {
		label: string;
		value: string;
	};
}

const { stat } = Astro.props;
---

<div class="flex flex-col items-center gap-2 rounded-xl border border-slate-800/40 bg-slate-900/30 p-5 backdrop-blur-sm">
	<span class="text-3xl font-bold text-slate-50 sm:text-4xl">{stat.value}</span>
	<span class="text-xs font-medium uppercase tracking-widest text-slate-400">{stat.label}</span>
</div>
