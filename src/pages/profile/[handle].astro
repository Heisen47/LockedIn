---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ProjectStack from "../../components/ProjectStack";
import EditProfileButton from "../../components/EditProfileButton";
import { FadeIn, StaggerContainer, StaggerItem } from "../../components/Animations";
import type { Project } from "../../components/ProjectStack";

const { params } = Astro;
const handle = params.handle ?? "alexcodes";

// Demo profile data (to be replaced by real data fetching later)
const profile = {
  name: handle === "alexcodes" ? "Alex Chen" : handle,
  handle,
  avatarUrl: "", 
  bio: "Full-stack dev. I ship collaborative tools and edge-powered services.",
  email: "alex@example.com",
  github: "https://github.com/alexcodes",
  linkedin: "https://www.linkedin.com/in/alexc",
  website: "https://alex.dev",
  tags: ["React", "TypeScript", "CRDT", "Edge", "Postgres"],
  stats: {
    projects: 12,
    followers: 842,
    following: 187,
    totalStars: 3560,
  },
};

const projects: Project[] = [
  {
    id: "p1",
    title: "Realtime Kanban",
    description: "A collaborative Kanban with CRDT sync and offline support.",
    tags: ["React", "CRDT", "WebSocket"],
    status: "live",
    score: 124,
    durationDays: 45,
    stars: 512,
    forks: 64,
    createdAt: "2025-10-01T14:35:00Z",
    comments: [],
  },
  {
    id: "p2",
    title: "Edge Vector Search",
    description: "Cloudflare Workers + HNSW for blazing vector search near users.",
    tags: ["Cloudflare", "HNSW", "TypeScript"],
    status: "building",
    score: 88,
    durationDays: 30,
    stars: 120,
    forks: 20,
    createdAt: "2025-10-10T09:12:00Z",
    comments: [],
  },
  {
    id: "p3",
    title: "AI Note Weaving",
    description: "Semantic backlinks that auto-organize notes into living maps.",
    tags: ["LLM", "Embeddings", "UX"],
    status: "live",
    score: 203,
    durationDays: 62,
    stars: 1240,
    forks: 150,
    createdAt: "2025-10-20T18:05:00Z",
    comments: [],
  },
];
---

<Layout>
  <Navbar loggedIn={true} page="profile" />

  <main class="relative min-h-screen w-full bg-[#050608] text-slate-100">
  <div class="mx-auto w-full max-w-6xl px-5 pb-24 pt-28 sm:px-8 lg:px-12" data-profile-handle={handle}>
      <!-- Profile Header -->
      <header class="mb-10">
        <FadeIn client:load>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              {profile.avatarUrl ? (
                <img src={profile.avatarUrl} alt={`${profile.name} avatar`} class="h-16 w-16 rounded-full border border-slate-800/60 object-cover" />
              ) : (
                <div class="h-16 w-16 rounded-full border border-slate-800/60 bg-linear-to-br from-cyan-500/20 to-fuchsia-500/20" />
              )}
              <div>
                <h1 class="text-2xl font-bold sm:text-3xl">{profile.name}</h1>
                <p class="text-slate-400">@{profile.handle}</p>
                <p id="profile-bio" class="mt-2 max-w-2xl text-sm text-slate-300">{profile.bio}</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a id="profile-email" href={`mailto:${profile.email}`} class="rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200 hover:border-slate-700/60">Email</a>
              <a href={profile.github} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200 hover:border-slate-700/60">GitHub</a>
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200 hover:border-slate-700/60">LinkedIn</a>
              <a id="profile-website" href={profile.website} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200 hover:border-slate-700/60">Website</a>
              <EditProfileButton
                client:load
                handle={profile.handle}
                initialEmail={profile.email}
                initialWebsite={profile.website}
                initialBio={profile.bio}
                className="rounded-xl border border-indigo-500/30 bg-[linear-gradient(in_oklab,to_right,#6EE7F9_0%,#7C3AED_100%)] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90"
              />
            </div>
          </div>
        </FadeIn>
      </header>

      <!-- Quick Stats -->
      <section class="mb-10">
        <StaggerContainer client:load className="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Projects</p>
              <p class="mt-1 text-xl font-semibold text-slate-100">{profile.stats.projects}</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Followers</p>
              <p class="mt-1 text-xl font-semibold text-slate-100">{profile.stats.followers}</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Following</p>
              <p class="mt-1 text-xl font-semibold text-slate-100">{profile.stats.following}</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Total Stars</p>
              <p class="mt-1 text-xl font-semibold text-slate-100">{profile.stats.totalStars}</p>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </section>

      <!-- Tech Stack Tags -->
      <section class="mb-12">
        <FadeIn client:load>
          <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6">
            <h2 class="mb-3 text-lg font-semibold text-slate-100">Tech Stack</h2>
            <div class="flex flex-wrap gap-2">
              {profile.tags.map((t) => (
                <span class="inline-flex items-center gap-1 rounded-full border border-slate-700/60 bg-slate-900/40 px-2.5 py-1 text-xs text-slate-300">#{t}</span>
              ))}
            </div>
          </div>
        </FadeIn>
      </section>

      <!-- Projects Stack -->
      <section>
        <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6 backdrop-blur-xl">
          <!-- Tab Toggle -->
          <div class="mb-6 flex items-center gap-2 rounded-lg border border-slate-800/50 bg-slate-950/40 p-1">
            <button
              type="button"
              id="tab-posts"
              class="profile-tab flex-1 rounded-md px-4 py-2 text-sm font-medium transition-all bg-slate-800/60 text-slate-100"
            >
              Posts
            </button>
            <button
              type="button"
              id="tab-comments"
              class="profile-tab flex-1 rounded-md px-4 py-2 text-sm font-medium transition-all text-slate-400"
            >
              Comments
            </button>
          </div>

          <!-- Posts View -->
          <div id="view-posts">
            <ProjectStack client:load user={{ name: profile.name, handle: profile.handle }} projects={projects} showFollow={false} />
          </div>

          <!-- Comments View -->
          <div id="view-comments" class="hidden">
            <div class="space-y-4">
              <!-- Placeholder for comments - to be replaced with actual comment data -->
              <div class="text-center py-12 text-slate-400">
                <svg class="mx-auto mb-4 h-12 w-12 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                </svg>
                <p class="text-sm">No comments yet</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    const root = document.querySelector('[data-profile-handle]');
    const profileHandle = (root && (root as HTMLElement).getAttribute('data-profile-handle')) || '';
    const get = (k: string) => {
      try { return localStorage.getItem(`profile:${profileHandle}:${k}`); } catch { return null; }
    };
    const apply = () => {
      const bioEl = document.getElementById('profile-bio');
      const emailEl = document.getElementById('profile-email');
      const websiteEl = document.getElementById('profile-website');
      const bio = get('bio');
      const email = get('email');
      const website = get('website');
      if (bioEl && bio) bioEl.textContent = bio;
      if (emailEl && email) emailEl.setAttribute('href', `mailto:${email}`);
      if (websiteEl && website) websiteEl.setAttribute('href', website);
    };
    if (typeof window !== 'undefined') {
      apply();
      window.addEventListener('profile:updated', (e: any) => {
        if (!e.detail || e.detail.handle !== profileHandle) return;
        apply();
      });
    }

    // Tab switching functionality
    const postsTab = document.getElementById('tab-posts');
    const commentsTab = document.getElementById('tab-comments');
    const postsView = document.getElementById('view-posts');
    const commentsView = document.getElementById('view-comments');

    function setActiveTab(tab: 'posts' | 'comments') {
      if (tab === 'posts') {
        postsTab?.classList.add('bg-slate-800/60', 'text-slate-100');
        postsTab?.classList.remove('text-slate-400');
        commentsTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
        commentsTab?.classList.add('text-slate-400');
        postsView?.classList.remove('hidden');
        commentsView?.classList.add('hidden');
      } else {
        commentsTab?.classList.add('bg-slate-800/60', 'text-slate-100');
        commentsTab?.classList.remove('text-slate-400');
        postsTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
        postsTab?.classList.add('text-slate-400');
        commentsView?.classList.remove('hidden');
        postsView?.classList.add('hidden');
      }
    }

    postsTab?.addEventListener('click', () => setActiveTab('posts'));
    commentsTab?.addEventListener('click', () => setActiveTab('comments'));

    // Initialize with posts active
    setActiveTab('posts');
  </script>
</Layout>
