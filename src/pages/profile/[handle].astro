---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ProjectStack from "../../components/ProjectStack";
import { FadeIn, StaggerContainer, StaggerItem } from "../../components/Animations";
import type { Project } from "../../components/ProjectStack";
import { Loader } from "lucide-react";

const { params } = Astro;
const handle = params.handle ?? "rex";

const projects: Project[] = [];
const profile = { username: handle };
---

<Layout>
  <Navbar loggedIn={true} page="profile" />

  <main class="relative min-h-screen w-full bg-[#050608] text-slate-100">
    <div class="mx-auto w-full max-w-6xl px-5 pb-24 pt-28 sm:px-8 lg:px-12" data-profile-handle={handle}>
      <!-- Profile Header -->
      <header class="mb-10">
        <FadeIn client:load>
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-4">
              <div class="h-16 w-16 rounded-full border border-slate-800/60 bg-linear-to-br from-cyan-500/20 to-fuchsia-500/20" />
              <div>
                <h1 id="profile-username" class="text-2xl font-bold sm:text-3xl">{handle}</h1>
                <p id="profile-handle" class="text-slate-400">@{handle}</p>
                <p id="profile-email" class="text-xs text-slate-500 hidden"></p>
                <p id="profile-bio" class="mt-2 max-w-2xl text-sm text-slate-300"><Loader className="inline-block h-3 w-3 animate-spin text-slate-400" /></p>
                <p id="profile-error" class="mt-2 text-xs text-amber-400 hidden"></p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a id="email-link" href="#" class="hidden rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200 hover:border-slate-700/60">
                Email
              </a>
              <span id="profile-role-badge" class="rounded-xl border border-slate-800/60 bg-slate-900/40 px-2.5 py-1.5 text-xs text-slate-200">
                <Loader className="inline-block h-3 w-3 animate-spin text-slate-400" />
              </span>
            </div>
          </div>
        </FadeIn>
      </header>

      <!-- Quick Stats -->
      <section class="mb-10">
        <StaggerContainer client:load className="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Posts</p>
              <p id="stat-posts" class="mt-1 text-xl font-semibold text-slate-100">—</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Comments</p>
              <p id="stat-comments" class="mt-1 text-xl font-semibold text-slate-100">—</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Followers</p>
              <p id="stat-followers" class="mt-1 text-xl font-semibold text-slate-100">—</p>
            </div>
          </StaggerItem>
          <StaggerItem>
            <div class="rounded-2xl border border-slate-800/60 bg-slate-900/30 p-4 text-center">
              <p class="text-xs uppercase tracking-wide text-slate-400">Following</p>
              <p id="stat-following" class="mt-1 text-xl font-semibold text-slate-100">—</p>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </section>

      <!-- Account Details -->
      <!-- <section class="mb-10">
        <FadeIn client:load>
          <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6">
            <h2 class="mb-4 text-lg font-semibold text-slate-100">Account Details</h2>
            <dl class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-800/60 bg-slate-900/40 p-4">
                <dt class="text-xs uppercase tracking-wide text-slate-400">Email</dt>
                <dd id="detail-email" class="mt-1 text-sm text-slate-100 wrap-break-word">Loading...</dd>
              </div>
              <div class="rounded-2xl border border-slate-800/60 bg-slate-900/40 p-4">
                <dt class="text-xs uppercase tracking-wide text-slate-400">Role</dt>
                <dd id="detail-role" class="mt-1 text-sm text-slate-100 wrap-break-word">Loading...</dd>
              </div>
            </dl>
          </div>
        </FadeIn>
      </section> -->

      <!-- Tech Stack Tags -->
      <section class="mb-12">
        <FadeIn client:load>
          <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6">
            <h2 class="mb-3 text-lg font-semibold text-slate-100">Tech Stack</h2>
            <div id="tech-stack-container" class="flex flex-wrap gap-2">
              <p class="text-sm text-slate-400"><Loader className="inline-block h-3 w-3 animate-spin text-slate-400" /></p>
            </div>
          </div>
        </FadeIn>
      </section>

      <!-- Projects Stack -->
      <section>
        <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6 backdrop-blur-xl">
          <div class="mb-6 flex items-center gap-2 rounded-lg border border-slate-800/50 bg-slate-950/40 p-1">
            <button type="button" id="tab-posts" class="profile-tab flex-1 rounded-md px-4 py-2 text-sm font-medium transition-all bg-slate-800/60 text-slate-100">
              Posts
            </button>
            <button type="button" id="tab-comments" class="profile-tab flex-1 rounded-md px-4 py-2 text-sm font-medium transition-all text-slate-400">
              Comments
            </button>
          </div>

          <div id="view-posts">
            <ProjectStack client:load user={{ name: profile.username, handle: profile.username }} projects={projects} showFollow={false} />
          </div>

          <div id="view-comments" class="hidden">
            <div class="py-12 text-center text-slate-400">
              <svg class="mx-auto mb-4 h-12 w-12 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
              </svg>
              <p class="text-sm">No comments yet</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    const handle = document.querySelector('[data-profile-handle]')?.getAttribute('data-profile-handle') || '';
    const baseUrl = import.meta.env.PUBLIC_API_BASE_URL;

    async function loadProfile() {
      const token = sessionStorage.getItem('authToken');
      
      try {
        const response = await fetch(`${baseUrl}/users/username/${encodeURIComponent(handle)}`, {
          headers: token ? { Authorization: `Bearer ${token}` } : {},
        });


        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
        
        const profile = data;

        if (!profile || !profile.username) {
          throw new Error('Invalid profile data in response');
        }

        // Update header
        const usernameEl = document.getElementById('profile-username');
        const handleEl = document.getElementById('profile-handle');
        const emailEl = document.getElementById('profile-email');
        const bioEl = document.getElementById('profile-bio');
        const roleBadge = document.getElementById('profile-role-badge');
        const emailLink = document.getElementById('email-link');

        if (usernameEl) usernameEl.textContent = profile.username;
        if (handleEl) handleEl.textContent = `@${profile.username}`;
        if (bioEl) bioEl.textContent = profile.bio || "This builder hasn't written a bio yet.";
        if (roleBadge) roleBadge.textContent = `Role: ${profile.role || 'USER'}`;

        if (profile.email) {
          if (emailEl) {
            emailEl.textContent = profile.email;
            emailEl.classList.remove('hidden');
          }
          if (emailLink) {
            emailLink.setAttribute('href', `mailto:${profile.email}`);
            emailLink.classList.remove('hidden');
          }
        }

        // Update stats
        const statPosts = document.getElementById('stat-posts');
        const statComments = document.getElementById('stat-comments');
        const statFollowers = document.getElementById('stat-followers');
        const statFollowing = document.getElementById('stat-following');

        if (statPosts) statPosts.textContent = String(profile.postsCount ?? 0);
        if (statComments) statComments.textContent = String(profile.commentsCount ?? 0);
        if (statFollowers) statFollowers.textContent = String(profile.followersCount ?? 0);
        if (statFollowing) statFollowing.textContent = String(profile.followingCount ?? 0);

        // Update account details
        const detailEmail = document.getElementById('detail-email');
        const detailRole = document.getElementById('detail-role');
        const detailId = document.getElementById('detail-id');
        const detailUpdated = document.getElementById('detail-updated');
        const updatedDate = profile.updatedAt ? new Date(profile.updatedAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : '—';

        if (detailEmail) detailEmail.textContent = profile.email || 'Not provided';
        if (detailRole) detailRole.textContent = profile.role || 'USER';
        if (detailId) detailId.textContent = profile.id || 'Unavailable';
        if (detailUpdated) detailUpdated.textContent = updatedDate;

        // Update tech stack
        const techContainer = document.getElementById('tech-stack-container');
        if (techContainer) {
          if (profile.techStack && profile.techStack.length > 0) {
            techContainer.innerHTML = profile.techStack
              .map((t: string) => `<span class="inline-flex items-center gap-1 rounded-full border border-slate-700/60 bg-slate-900/40 px-2.5 py-1 text-xs text-slate-300">#${t}</span>`)
              .join('');
          } else {
            techContainer.innerHTML = '<p class="text-sm text-slate-400">No tech stack listed yet.</p>';
          }
        }


      } catch (error: any) {
        console.error('Failed to load profile:', error);
        const errorEl = document.getElementById('profile-error');
        const bioEl = document.getElementById('profile-bio');
        if (errorEl) {
          errorEl.textContent = `Unable to load profile: ${error.message}`;
          errorEl.classList.remove('hidden');
        }
        if (bioEl) bioEl.textContent = "This builder hasn't written a bio yet.";

        // Set fallback values
        document.querySelectorAll('#stat-posts, #stat-comments, #stat-followers, #stat-following').forEach(el => el.textContent = '0');
        document.querySelectorAll('#detail-email').forEach(el => el.textContent = 'Not provided');
        document.querySelectorAll('#detail-role').forEach(el => el.textContent = 'USER');
        document.querySelectorAll('#detail-id').forEach(el => el.textContent = 'Unavailable');
        document.querySelectorAll('#detail-updated').forEach(el => el.textContent = '—');
        const techContainer = document.getElementById('tech-stack-container');
        if (techContainer) techContainer.innerHTML = '<p class="text-sm text-slate-400">No tech stack listed yet.</p>';
      }
    }

    // Tab switching logic
    const postsTab = document.getElementById('tab-posts');
    const commentsTab = document.getElementById('tab-comments');
    const postsView = document.getElementById('view-posts');
    const commentsView = document.getElementById('view-comments');

    function setActiveTab(tab: 'posts' | 'comments') {
      if (tab === 'posts') {
        postsTab?.classList.add('bg-slate-800/60', 'text-slate-100');
        postsTab?.classList.remove('text-slate-400');
        commentsTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
        commentsTab?.classList.add('text-slate-400');
        postsView?.classList.remove('hidden');
        commentsView?.classList.add('hidden');
      } else {
        commentsTab?.classList.add('bg-slate-800/60', 'text-slate-100');
        commentsTab?.classList.remove('text-slate-400');
        postsTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
        postsTab?.classList.add('text-slate-400');
        commentsView?.classList.remove('hidden');
        postsView?.classList.add('hidden');
      }
    }

    postsTab?.addEventListener('click', () => setActiveTab('posts'));
    commentsTab?.addEventListener('click', () => setActiveTab('comments'));
    setActiveTab('posts');

    // Load profile data
    loadProfile();
  </script>
</Layout>
