---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ProjectStack from "../components/ProjectStack";

// Reuse demo data similar to feed, but filtered to status "building".
const users = [
  {
    name: "Alex Chen",
    handle: "alexcodes",
    projects: [
      {
        id: "p2",
        title: "Edge Vector Search",
        description: "Cloudflare Workers + HNSW for blazing vector search near users.",
        tags: ["Cloudflare", "HNSW", "TypeScript"],
        status: "building",
        score: 88,
      },
    ],
  },
  {
    name: "Sara Malik",
    handle: "saram",
    projects: [
      {
        id: "p5",
        title: "3D Scene Editor",
        description: "Browser-native scene editor with procedural assets.",
        tags: ["Three.js", "WebGPU", "Procedural"],
        status: "building",
        score: 150,
      },
    ],
  },
];
---

<Layout>
  <Navbar page="building" />

  <main class="relative min-h-screen w-full bg-[#050608] text-slate-100">
    <div class="mx-auto w-full max-w-6xl px-5 pb-24 pt-28 sm:px-8 lg:px-12">
      <header class="mb-10">
        <h1 class="text-3xl font-bold sm:text-4xl">Building</h1>
        <p class="mt-2 text-slate-400">Work-in-progress projects. Follow along and give feedback.</p>
      </header>

      <section class="space-y-10">
        {users.map((u) => (
          <div class="rounded-3xl border border-slate-800/60 bg-slate-900/30 p-6 backdrop-blur-xl">
            <ProjectStack client:load user={{ name: u.name, handle: u.handle }} projects={u.projects as any} />
          </div>
        ))}
      </section>
    </div>
  </main>
</Layout>
