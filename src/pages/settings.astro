---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TechStackInput from '../components/TechStackInput';
import { User as UserIcon, Share2 as ShareIcon, Cog as CogIcon, Bell as BellIcon } from 'lucide-react';
---

<Layout title="Settings - LockedIn">
  <Navbar loggedIn={true} page="settings" />
  <div class="relative min-h-screen w-full bg-[#050608] text-slate-100 py-8">
    <div id="settings-root" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-3xl font-bold py-7">Settings</h1>
        <button id="back-to-feed" class="inline-flex items-center gap-2 rounded-xl border border-slate-800/60 bg-slate-900/40 px-4 py-2 text-sm text-slate-200 hover:border-slate-700/60">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to Feed
        </button>
      </div>
      
      <div class="flex gap-4 sm:gap-8">
        <!-- Left Sidebar - Categories -->
        <div class="w-16 sm:w-64 flex-shrink-0">
          <nav class="rounded-2xl border border-slate-800/60 bg-slate-900/30 backdrop-blur-xl p-2 sm:p-4 sticky top-8">
            <ul class="space-y-1 sm:space-y-2">
              <li>
                <button 
                  id="btn-user" 
                  class="settings-nav-btn active w-full text-left px-3 sm:px-4 py-3 rounded-xl text-slate-100 font-medium transition-all duration-200 hover:bg-slate-900/50 flex items-center justify-center sm:justify-start gap-0 sm:gap-3"
                  data-section="user"
                >
                  <UserIcon class="w-5 h-5" />
                  <span class="hidden sm:inline">User Settings</span>
                </button>
              </li>
              <li>
                <button 
                  id="btn-social" 
                  class="settings-nav-btn w-full text-left px-3 sm:px-4 py-3 rounded-xl text-slate-400 font-medium transition-all duration-200 hover:bg-slate-900/50 flex items-center justify-center sm:justify-start gap-0 sm:gap-3"
                  data-section="social"
                >
                  <ShareIcon class="w-5 h-5" />
                  <span class="hidden sm:inline">Social Settings</span>
                </button>
              </li>
              <li>
                <button 
                  id="btn-account" 
                  class="settings-nav-btn w-full text-left px-3 sm:px-4 py-3 rounded-xl text-slate-400 font-medium transition-all duration-200 hover:bg-slate-900/50 flex items-center justify-center sm:justify-start gap-0 sm:gap-3"
                  data-section="account"
                >
                  <CogIcon class="w-5 h-5" />
                  <span class="hidden sm:inline">Account Settings</span>
                </button>
              </li>
              <li>
                <button 
                  id="btn-notifications" 
                  class="settings-nav-btn w-full text-left px-3 sm:px-4 py-3 rounded-xl text-slate-400 font-medium transition-all duration-200 hover:bg-slate-900/50 flex items-center justify-center sm:justify-start gap-0 sm:gap-3"
                  data-section="notifications"
                >
                  <BellIcon class="w-5 h-5" />
                  <span class="hidden sm:inline">Notification Settings</span>
                </button>
              </li>
            </ul>
          </nav>
        </div>

        <!-- Right Content - Settings Panels -->
        <div class="flex-1">
          <!-- User Settings Panel -->
          <section id="section-user" class="settings-section rounded-2xl border border-slate-800/60 bg-slate-900/30 backdrop-blur-xl p-4 sm:p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
              <UserIcon class="w-6 h-6 text-purple-400" />
              User Settings
            </h2>
            
            <div class="space-y-6">
              <!-- Profile Picture -->
              <div class="flex items-center gap-6">
                <div class="relative">
                  <div id="avatar-preview" class="w-24 h-24 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white text-3xl font-bold overflow-hidden">
                    <span id="avatar-initials">?</span>
                  </div>
                  <label class="absolute bottom-0 right-0 bg-purple-600 hover:bg-purple-700 text-white p-2 rounded-full cursor-pointer transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <input type="file" accept="image/*" class="hidden" id="avatar-input" />
                  </label>
                </div>
                <div>
                  <h3 class="font-medium">Profile Picture</h3>
                  <p class="text-slate-400 text-sm">JPG, PNG or GIF. Max 2MB.</p>
                </div>
              </div>

              <!-- Display Name -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Display Name</label>
                <input 
                  type="text" 
                  id="display-name" 
                  class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                  placeholder="Your display name"
                />
              </div>

              <!-- Username -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Username</label>
                <div class="flex items-center">
                  <span class="px-4 py-3 bg-slate-900/50 border border-r-0 border-slate-800/60 rounded-l-xl text-slate-400">@</span>
                  <input 
                    type="text" 
                    id="username" 
                    class="flex-1 px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-r-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                    placeholder="username"
                  />
                </div>
              </div>

              <!-- Bio -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Bio</label>
                <textarea 
                  id="bio" 
                  rows="4"
                  class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all resize-none"
                  placeholder="Tell us about yourself..."
                ></textarea>
                <p class="text-slate-500 text-sm mt-1">Max 160 characters</p>
              </div>

              <!-- Tech Stack -->
              <div id="techstack-wrapper">
                <TechStackInput 
                  client:load
                  tags={[]}
                  maxTags={10}
                  label="Tech Stack Tags"
                  placeholder="Type to search tech stack..."
                  onTagsChange={(tags) => {}}
                />
              </div>

              <button class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]">
                Save User Settings
              </button>
            </div>
          </section>

          <!-- Social Settings Panel -->
          <section id="section-social" class="settings-section hidden rounded-2xl border border-slate-800/60 bg-slate-900/30 backdrop-blur-xl p-4 sm:p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
              <ShareIcon class="w-6 h-6 text-purple-400" />
              Social Settings
            </h2>
            
            <div class="space-y-6">
              <!-- GitHub -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">GitHub Profile</label>
                <div class="flex items-center">
                  <span class="px-4 py-3 bg-slate-900/50 border border-r-0 border-slate-800/60 rounded-l-xl text-slate-400">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  </span>
                  <input 
                    type="url" 
                    id="github-url" 
                    class="flex-1 px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-r-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                    placeholder="https://github.com/username"
                  />
                </div>
              </div>

              <!-- LinkedIn -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">LinkedIn Profile</label>
                <div class="flex items-center">
                  <span class="px-4 py-3 bg-slate-900/50 border border-r-0 border-slate-800/60 rounded-l-xl text-slate-400">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </span>
                  <input 
                    type="url" 
                    id="linkedin-url" 
                    class="flex-1 px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-r-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                    placeholder="https://linkedin.com/in/username"
                  />
                </div>
              </div>

              <!-- Twitter/X -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Twitter / X</label>
                <div class="flex items-center">
                  <span class="px-4 py-3 bg-slate-900/50 border border-r-0 border-slate-800/60 rounded-l-xl text-slate-400">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </span>
                  <input 
                    type="url" 
                    id="twitter-url" 
                    class="flex-1 px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-r-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                    placeholder="https://x.com/username"
                  />
                </div>
              </div>

              <!-- Personal Website -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Personal Website</label>
                <div class="flex items-center">
                  <span class="px-4 py-3 bg-slate-900/50 border border-r-0 border-slate-800/60 rounded-l-xl text-slate-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                  </span>
                  <input 
                    type="url" 
                    id="website-url" 
                    class="flex-1 px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-r-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                    placeholder="https://yourwebsite.com"
                  />
                </div>
              </div>

              <button class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]">
                Save Social Links
              </button>
            </div>
          </section>

          <!-- Account Settings Panel -->
          <section id="section-account" class="settings-section hidden rounded-2xl border border-slate-800/60 bg-slate-900/30 backdrop-blur-xl p-4 sm:p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
              <CogIcon class="w-6 h-6 text-purple-400" />
              Account Settings
            </h2>
            
            <div class="space-y-6">
              <!-- Email -->
              <div>
                <label class="block text-slate-300 text-sm font-medium mb-2">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                  placeholder="your@email.com"
                />
              </div>

              <!-- Change Password Section -->
              <div class="pt-6 border-t border-slate-800/60">
                <h3 class="text-lg font-semibold">Change Password</h3>
                
                <div class="space-y-4">
                  <div>
                    <label class="block text-slate-300 text-sm font-medium mb-2">Current Password</label>
                    <input 
                      type="password" 
                      id="current-password" 
                      class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                      placeholder="••••••••"
                    />
                  </div>
                  <div>
                    <label class="block text-slate-300 text-sm font-medium mb-2">New Password</label>
                    <input 
                      type="password" 
                      id="new-password" 
                      class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                      placeholder="••••••••"
                    />
                  </div>
                  <div>
                    <label class="block text-slate-300 text-sm font-medium mb-2">Confirm New Password</label>
                    <input 
                      type="password" 
                      id="confirm-password" 
                      class="w-full px-4 py-3 bg-slate-900/40 border border-slate-800/60 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all"
                      placeholder="••••••••"
                    />
                  </div>
                </div>
              </div>

              <button class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]">
                Update Account
              </button>

              <!-- Danger Zone -->
              <div class="pt-6 border-t border-red-500/30 mt-8">
                <h3 class="text-lg font-semibold text-red-400 mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  Danger Zone
                </h3>
                <p class="text-slate-400 text-sm mb-4">Once you delete your account, there is no going back. Please be certain.</p>
                <button 
                  id="delete-account-btn"
                  class="px-6 py-3 bg-red-600/20 hover:bg-red-600/40 text-red-400 border border-red-500/50 rounded-xl font-medium transition-all duration-200"
                >
                  Delete Account
                </button>
              </div>
            </div>
          </section>

          <!-- Notification Settings Panel -->
          <section id="section-notifications" class="settings-section hidden rounded-2xl border border-slate-800/60 bg-slate-900/30 backdrop-blur-xl p-4 sm:p-8">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
              <BellIcon class="w-6 h-6 text-purple-400" />
              Notification Settings
            </h2>
            
            <div class="space-y-6">
              <!-- Email Notifications -->
              <div class="space-y-4">
                <h3 class="text-lg font-semibold text-white">Email Notifications</h3>
                
                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">New Comments</p>
                    <p class="text-slate-400 text-sm">Get notified when someone comments on your posts</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="notify-comments" class="sr-only peer" checked />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>

                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">New Followers</p>
                    <p class="text-slate-400 text-sm">Get notified when someone follows you</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="notify-followers" class="sr-only peer" checked />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>

                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">Upvotes</p>
                    <p class="text-slate-400 text-sm">Get notified when your posts receive upvotes</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="notify-upvotes" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>

                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">Mentions</p>
                    <p class="text-slate-400 text-sm">Get notified when someone mentions you</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="notify-mentions" class="sr-only peer" checked />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>
              </div>

              <!-- Push Notifications -->
              <div class="space-y-4 pt-6 border-t border-slate-800/60">
                <h3 class="text-lg font-semibold text-white">Push Notifications</h3>
                
                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">Enable Push Notifications</p>
                    <p class="text-slate-400 text-sm">Receive push notifications in your browser</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="push-enabled" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>
              </div>

              <!-- Marketing -->
              <div class="space-y-4 pt-6 border-t border-slate-800/60">
                <h3 class="text-lg font-semibold text-white">Marketing</h3>
                
                <div class="flex items-center justify-between p-4 bg-slate-900/40 rounded-xl border border-slate-800/60">
                  <div>
                    <p class="text-slate-100 font-medium">Newsletter</p>
                    <p class="text-slate-400 text-sm">Receive our weekly newsletter with updates and tips</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="newsletter" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-800/60 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-500 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-600 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                  </label>
                </div>
              </div>

              <button class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]">
                Save Notification Preferences
              </button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Account Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 hidden">
    <div class="bg-slate-800 border border-white/20 rounded-2xl p-8 max-w-md w-full mx-4">
      <div class="flex items-center gap-4 mb-4">
        <div class="p-3 bg-red-500/20 rounded-full">
          <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white">Delete Account</h3>
      </div>
      <p class="text-white/70 mb-6">Are you sure you want to delete your account? This action cannot be undone and all your data will be permanently removed.</p>
      <div class="flex gap-4">
        <button id="cancel-delete" class="flex-1 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl transition-colors">
          Cancel
        </button>
        <button id="confirm-delete" class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-colors">
          Delete Account
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .settings-nav-btn.active {
    background: linear-gradient(135deg, rgba(17, 24, 39, 0.6), rgba(17, 24, 39, 0.4));
    color: #e5e7eb;
    border: 1px solid rgba(30, 41, 59, 0.6);
  }
</style>

<script>
  // Navigation functionality
  const navButtons = document.querySelectorAll('.settings-nav-btn');
  const sections = document.querySelectorAll('.settings-section');
  let unsavedChanges = false;

  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const sectionId = btn.getAttribute('data-section');
      
      // Update nav buttons
      navButtons.forEach(b => {
        b.classList.remove('active');
        b.classList.remove('text-slate-100');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('active');
      btn.classList.remove('text-slate-400');
      btn.classList.add('text-slate-100');
      
      // Show/hide sections
      sections.forEach(section => {
        if (section.id === `section-${sectionId}`) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });

  // Load user data on page load
  document.addEventListener('DOMContentLoaded', () => {
    const username = sessionStorage.getItem('username');
    const email = sessionStorage.getItem('email');
    
    if (username) {
      const usernameInput = document.getElementById('username') as HTMLInputElement;
      const avatarInitials = document.getElementById('avatar-initials');
      if (usernameInput) usernameInput.value = username;
      if (avatarInitials) avatarInitials.textContent = username.charAt(0).toUpperCase();
    }
    
    if (email) {
      const emailInput = document.getElementById('email') as HTMLInputElement;
      if (emailInput) emailInput.value = email;
    }

    // Track unsaved changes across the page
    const root = document.getElementById('settings-root');
    const markChanged = () => { unsavedChanges = true; };
    root && root.addEventListener('input', markChanged, true);
    root && root.addEventListener('change', markChanged, true);
    const techstackWrapper = document.getElementById('techstack-wrapper');
    techstackWrapper && techstackWrapper.addEventListener('click', markChanged, true);

    // Back to feed with confirmation
    const backBtn = document.getElementById('back-to-feed');
    backBtn && backBtn.addEventListener('click', () => {
      if (unsavedChanges) {
        const leave = confirm('You have unsaved changes. Discard them and go back to the feed?');
        if (!leave) return;
      }
      window.location.href = '/';
    });
  });

  // Delete account modal
  const deleteBtn = document.getElementById('delete-account-btn');
  const deleteModal = document.getElementById('delete-modal');
  const cancelDelete = document.getElementById('cancel-delete');
  const confirmDelete = document.getElementById('confirm-delete');

  deleteBtn?.addEventListener('click', () => {
    deleteModal?.classList.remove('hidden');
  });

  cancelDelete?.addEventListener('click', () => {
    deleteModal?.classList.add('hidden');
  });

  confirmDelete?.addEventListener('click', async () => {
    // TODO: Implement delete account API call
    alert('Account deletion would be processed here');
    deleteModal?.classList.add('hidden');
  });

  // Close modal on backdrop click
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
      deleteModal.classList.add('hidden');
    }
  });

  // Avatar preview
  const avatarInput = document.getElementById('avatar-input');
  const avatarPreview = document.getElementById('avatar-preview');

  avatarInput?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const file = input && input.files ? input.files[0] : undefined;
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        if (avatarPreview) {
          avatarPreview.innerHTML = `<img src="${e.target?.result}" class="w-full h-full object-cover" />`;
        }
      };
      reader.readAsDataURL(file);
    }
  });
</script>
