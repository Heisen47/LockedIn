---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatCard from "../components/StatCard.astro";
import InteractiveBackground from "../components/InteractiveBackground";
import { FadeIn, StaggerContainer, StaggerItem, ScaleIn } from "../components/Animations";

const stats = [
  { label: "Daily Ship Logs", value: "4.1K" },
  { label: "Build Threads", value: "980" },
  { label: "Verified Repos", value: "3.6K" },
];

const features = [
  {
    title: "Ship Notes & Updates",
    description: "Post context-rich changelog entries with links, screenshots, and tech stack tags.",
  },
  {
    title: "Show Build Timeline",
    description: "Timeline view lets people replay your product arc from first commit to launch.",
  },
  {
    title: "Signal-Boost Launches",
    description: "Schedule launch posts, collect votes, and route curious people to your live demo.",
  },
];

const howItWorks = [
  {
    step: "01",
    title: "Connect With GitHub",
    description: "Secure OAuth pulls your public repos and lets you pick what appears on your profile.",
  },
  {
    step: "02",
    title: "Craft Your Build Log",
    description: "Use the editor to add milestones, embed media, and tag the stack behind each feature.",
  },
  {
    step: "03",
    title: "Publish & Engage",
    description: "Go live, request votes, invite collaborators, and reply to comments in one place.",
  },
];

const benefits = [
  {
    title: "Own Your Builder Profile",
    description: "Rich profile pulls commits, streaks, and highlights so hiring managers see proof, not claims.",
  },
  {
    title: "Host Launch Rooms",
    description: "Spin up a launch room with live chat, pinned links, and post-launch updates.",
  },
  {
    title: "Track Interest",
    description: "Analytics show who viewed, followed, or clipped your project so you can follow up.",
  },
  {
    title: "Team Buildspaces",
    description: "Invite teammates, assign roles, and maintain a shared roadmap visible to your followers.",
  },
];
---

<Layout>
  <Navbar page="about" />
	
  <main
    class="relative isolate z-10 min-h-screen w-full overflow-hidden bg-[#050608] bg-fixed text-slate-100"
    aria-labelledby="locked-in-heading"
  >
    <!-- Interactive Background -->
    <InteractiveBackground client:load />
		
    <!-- Static Background Gradients -->
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_10%_20%,rgba(76,29,149,0.15),transparent_60%),radial-gradient(circle_at_90%_0%,rgba(6,182,212,0.1),transparent_55%)]"
      aria-hidden="true"
    ></div>
		
    <div
      class="pointer-events-none absolute left-1/2 top-[-20vh] -z-10 h-[70vw] w-[70vw] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(14,116,144,0.2)_0%,rgba(14,116,144,0)_60%)] blur-[120px] opacity-50"
      aria-hidden="true"
    ></div>

    <div class="mx-auto flex w-full max-w-6xl flex-col px-5 pb-20 pt-32 sm:px-8 lg:px-12">
      <!-- Hero Section -->
      <section class="mb-32 flex flex-col items-center text-center">
        <FadeIn client:load>
          <h1 
            class="mb-6 max-w-4xl text-4xl leading-tight tracking-tight sm:text-5xl lg:text-5xl" 
            id="locked-in-heading"
          >
            Explain every ship, milestone, and win on one living portfolio
          </h1>
        </FadeIn>
				
        <FadeIn delay={0.2} client:load>
          <p class="mb-10 max-w-2xl text-lg text-slate-300 sm:text-xl">
            LockedIn is the builder homepage. Import repos, run public build logs, collect votes, and point people straight to what you shipped today.
          </p>
        </FadeIn>
				
        <FadeIn delay={0.4} client:load>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a
              href="/auth"
                class="inline-flex items-center justify-center rounded-full border border-slate-700/60 bg-[linear-gradient(in_oklab,to_right,#fdeff9_0%,#ec38bc_35%,#7303c0_75%,#03001e_100%)] px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur-sm transition hover:border-slate-600/60 hover:opacity-90"
            >
              Join Us!
            </a>
            <a
              href="#features"
              class="inline-flex items-center justify-center rounded-full border border-slate-700/60 bg-slate-900/40 px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur-sm transition hover:border-slate-600/60 hover:bg-slate-800/40"
            >
              Learn More
            </a>
          </div>
        </FadeIn>

        <!-- Stats -->
                <StaggerContainer client:load className="mt-20 grid w-full max-w-3xl grid-cols-3 gap-4">
                    {stats.map((stat) => (
                        <StaggerItem>
              <div class="relative rounded-2xl p-px overflow-hidden shadow-[0_0_30px_rgba(6,182,212,0.3),0_0_60px_rgba(6,182,212,0.15)]">
                                <div class="absolute inset-0 animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_0deg,transparent_0%,transparent_40%,rgba(6,182,212,0.9)_50%,transparent_60%,transparent_100%)]"></div>
                                <div class="relative bg-slate-900/90 rounded-2xl">
                                    <StatCard stat={stat} />
                                </div>
                            </div>
                        </StaggerItem>
                    ))}
                </StaggerContainer>
      </section>

      <!-- Features Section -->
      <section id="features" class="mb-32">
        <FadeIn client:load>
          <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">What you can do here</h2>
            <p class="mx-auto max-w-2xl text-slate-400">
              Every interaction is designed for shipping: publish build notes, showcase timelines, host launch rooms, and discover the next collab.
            </p>
          </div>
        </FadeIn>
				
        <StaggerContainer client:load className="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((feature) => (
            <StaggerItem>
              <FeatureCard title={feature.title} description={feature.description} />
            </StaggerItem>
          ))}
        </StaggerContainer>
      </section>

      <!-- How It Works Section -->
      <section class="mb-32">
        <FadeIn client:load>
          <div class="mb-16 text-center">
            <h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">How it works</h2>
            <p class="mx-auto max-w-2xl text-slate-400">
              LockedIn keeps everything async: connect, document, and publish without leaving your workflow.
            </p>
          </div>
        </FadeIn>

        <StaggerContainer client:load className="grid gap-8 md:grid-cols-3">
          {howItWorks.map((item) => (
            <StaggerItem className="relative">
              <div class="flex flex-col items-center text-center">
                <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-cyan-500/30 bg-cyan-500/10 text-2xl font-bold text-cyan-400">
                  {item.step}
                </div>
                <h3 class="mb-3 text-xl font-semibold text-slate-100">{item.title}</h3>
                <p class="text-slate-400">{item.description}</p>
              </div>
            </StaggerItem>
          ))}
        </StaggerContainer>
      </section>

      <!-- Benefits Section -->
      <section class="mb-32">
        <FadeIn client:load>
          <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">Why builders stay</h2>
            <p class="mx-auto max-w-2xl text-slate-400">
              We obsess over momentum. These tools keep you shipping in public without the busywork.
            </p>
          </div>
        </FadeIn>

        <StaggerContainer client:load className="grid gap-6 sm:grid-cols-2">
          {benefits.map((benefit) => (
            <StaggerItem>
              <div class="rounded-2xl border border-slate-800/50 bg-slate-900/30 p-6 backdrop-blur-sm transition-all hover:border-slate-700/60 hover:bg-slate-800/40">
                <h3 class="mb-3 text-lg font-semibold text-slate-100">{benefit.title}</h3>
                <p class="text-sm text-slate-400">{benefit.description}</p>
              </div>
            </StaggerItem>
          ))}
        </StaggerContainer>
      </section>

      <!-- Social Proof Section -->
      <FadeIn client:load>
        <section class="mb-32">
          <div class="rounded-3xl border border-slate-800/50 bg-slate-900/30 p-8 backdrop-blur-sm sm:p-12">
            <div class="text-center">
              <p class="mb-6 text-2xl font-semibold italic text-slate-300 sm:text-3xl">
                "Every launch now has context. Investors and collaborators can replay exactly how we built."
              </p>
              <div class="flex items-center justify-center gap-3">
                <div class="h-12 w-12 rounded-full bg-linear-to-br from-cyan-400 to-pink-500"></div>
                <div class="text-left">
                  <p class="font-semibold text-slate-200">Morgan Reyes</p>
                  <p class="text-sm text-slate-400">Indie SaaS Founder</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </FadeIn>

      <!-- CTA Section -->
      <ScaleIn client:load>
        <section id="community" class="mb-20 rounded-3xl border border-slate-800/50 bg-slate-900/30 p-12 text-center backdrop-blur-sm sm:p-16">
          <h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">
            Tell the full build story.
          </h2>
          <p class="mb-8 text-lg text-slate-300">
            Join thousands of engineers logging progress, launching faster, and getting noticed.
          </p>
          <a
            href="/auth"
            class="inline-flex items-center justify-center rounded-full border border-slate-700/60 bg-[linear-gradient(in_oklab,to_right,#fdeff9_0%,#ec38bc_35%,#7303c0_75%,#03001e_100%)] px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur-sm transition hover:border-slate-600/60 hover:opacity-90"
          >
            Get Started
          </a>
        </section>
      </ScaleIn>

      <!-- Footer -->
      <footer class="border-t border-slate-800/30 pt-10 text-center">
        <div class="mb-6 flex items-center justify-center gap-3">
          <span class="h-2 w-2 rounded-full bg-linear-to-br from-cyan-400 to-pink-500"></span>
          <span class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-200">LockedIn</span>
        </div>
        <p class="mb-6 text-sm text-slate-400">For builders who ship.</p>
                <nav class="flex flex-wrap justify-center gap-6 text-sm text-slate-400" aria-label="Footer">
                    <a class="transition-colors hover:text-slate-200 cursor-pointer" href="https://github.com/Heisen47" target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a class="transition-colors hover:text-slate-200 cursor-pointer" href="https://x.com/iWriteCode__" target="_blank" rel="noopener noreferrer">Twitter</a>
                    <a class="transition-colors hover:text-slate-200 cursor-pointer" href="https://www.linkedin.com/in/saptarshi-chakraborty-3031999march/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                </nav>
      </footer>
    </div>
  </main>
</Layout>
