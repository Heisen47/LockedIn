---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout>
	<Navbar transparent={true} minimal={true} />
	
	<main
		class="relative isolate flex min-h-screen w-full items-center justify-center overflow-hidden bg-[#050608] bg-fixed bg-[radial-gradient(circle_at_10%_20%,rgba(76,29,149,0.2),transparent_60%),radial-gradient(circle_at_90%_0%,rgba(6,182,212,0.15),transparent_55%)] text-slate-100"
	>
		<div
			class="pointer-events-none absolute left-1/2 top-[-20vh] -z-10 h-[70vw] w-[70vw] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(14,116,144,0.3)_0%,rgba(14,116,144,0)_60%)] blur-[120px] opacity-50"
			aria-hidden="true"
		></div>

		<div class="mx-auto w-full max-w-6xl px-5 py-28 sm:px-8">
			<div class="grid grid-cols-1 items-stretch gap-10 lg:grid-cols-2 lg:gap-12">
				<!-- Left: Brand/Benefits Panel -->
				<section class="order-2 flex flex-col rounded-3xl border border-slate-800/50 bg-slate-900/30 p-8 backdrop-blur-xl sm:p-10 lg:order-1">
					<div class="mb-6 flex items-center gap-3">
						<span class="h-3 w-3 rounded-full bg-linear-to-br from-cyan-400 to-pink-500 shadow-[0_0_16px_rgba(236,72,153,0.6)]"></span>
						<span class="text-lg font-semibold uppercase tracking-[0.12em] text-slate-100">LockedIn</span>
					</div>
					<h2 class="mb-3 text-3xl font-bold text-slate-100 sm:text-4xl">Stay in flow. Ship more.</h2>
					<p class="mb-8 max-w-md text-sm leading-relaxed text-slate-400">
						Sign in to connect your developer identity. We’ll help you track streaks, showcase work, and keep momentum—all privacy-first.
					</p>
					<ul class="grid flex-1 content-start gap-3 text-sm text-slate-300 sm:grid-cols-2">
						<li class="flex items-start gap-3 rounded-xl border border-slate-800/50 bg-slate-950/30 p-4">
							<span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400"></span>
							<span class="leading-relaxed">Minimal dashboard with streak tracking</span>
						</li>
						<li class="flex items-start gap-3 rounded-xl border border-slate-800/50 bg-slate-950/30 p-4">
							<span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-pink-400"></span>
							<span class="leading-relaxed">Auto-sync GitHub/GitLab activity</span>
						</li>
						<li class="flex items-start gap-3 rounded-xl border border-slate-800/50 bg-slate-950/30 p-4">
							<span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-400"></span>
							<span class="leading-relaxed">Privacy-first permissions</span>
						</li>
						<li class="flex items-start gap-3 rounded-xl border border-slate-800/50 bg-slate-950/30 p-4">
							<span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
							<span class="leading-relaxed">Fast, distraction-free UI</span>
						</li>
					</ul>
				</section>

				<!-- Right: Auth Card -->
				<section class="order-1 lg:order-2">
					<div class="rounded-3xl border border-slate-800/50 bg-slate-900/40 p-8 backdrop-blur-xl sm:p-10">
						<!-- Header -->
						<div class="mb-8 text-center">
							<div class="mb-4 flex items-center justify-center gap-3">
								<span class="h-3 w-3 rounded-full bg-linear-to-br from-cyan-400 to-pink-500 shadow-[0_0_16px_rgba(236,72,153,0.6)]"></span>
								<span class="text-lg font-semibold uppercase tracking-[0.12em] text-slate-100">LockedIn</span>
							</div>
							<h1 class="mb-2 text-2xl font-bold text-slate-100 sm:text-3xl">Welcome back</h1>
							<p class="text-sm text-slate-400">Sign in with your developer account to continue</p>
						</div>

						<!-- Auth Buttons -->
						<div class="space-y-3">
							<!-- GitHub Button -->
							<button
								type="button"
								class="group flex w-full items-center justify-center gap-3 rounded-xl border border-slate-700/60 bg-slate-800/40 px-5 py-3.5 text-sm font-semibold text-slate-100 backdrop-blur-sm transition-all hover:border-slate-600/60 hover:bg-slate-700/50 hover:shadow-[0_8px_24px_rgba(0,0,0,0.3)] focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:ring-offset-2 focus:ring-offset-slate-900"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github-icon lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
								<span>Continue with GitHub</span>
							</button>

							<!-- GitLab Button -->
							<button
								type="button"
								class="group flex w-full items-center justify-center gap-3 rounded-xl border border-slate-700/60 bg-slate-800/40 px-5 py-3.5 text-sm font-semibold text-slate-100 backdrop-blur-sm transition-all hover:border-slate-600/60 hover:bg-slate-700/50 hover:shadow-[0_8px_24px_rgba(0,0,0,0.3)] focus:outline-none focus:ring-2 focus:ring-pink-500/50 focus:ring-offset-2 focus:ring-offset-slate-900"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gitlab-icon lucide-gitlab"><path d="m22 13.29-3.33-10a.42.42 0 0 0-.14-.18.38.38 0 0 0-.22-.11.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18l-2.26 6.67H8.32L6.1 3.26a.42.42 0 0 0-.1-.18.38.38 0 0 0-.26-.08.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18L2 13.29a.74.74 0 0 0 .27.83L12 21l9.69-6.88a.71.71 0 0 0 .31-.83Z"/></svg>
								<span>Continue with GitLab</span>
							</button>
						</div>

						<!-- Divider -->
						<div class="my-6 flex items-center">
							<div class="h-px flex-1 bg-slate-800"></div>
							<span class="px-4 text-xs font-medium uppercase tracking-wider text-slate-500">Secure Auth</span>
							<div class="h-px flex-1 bg-slate-800"></div>
						</div>

						<!-- Info -->
						<div class="space-y-2.5 rounded-xl border border-slate-800/40 bg-slate-950/40 p-3.5">
							<div class="flex items-start gap-2.5">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check-icon lucide-shield-check"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
							</svg>
							<div>
								<p class="text-xs font-semibold text-slate-200">OAuth 2.0 Protocol</p>
								<p class="text-xs text-slate-400">We never see your password. Authentication is handled securely by GitHub or GitLab.</p>
							</div>
							</div>
							<div class="flex items-start gap-2.5">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole-icon lucide-lock-keyhole"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
							<div>
								<p class="text-xs font-semibold text-slate-200">Read-Only Access</p>
								<p class="text-xs text-slate-400">We only request read access to your public profile and repositories.</p>
							</div>
							</div>
						</div>

						<!-- Footer Note -->
						<p class="mt-5 text-center text-xs text-slate-500">
							By continuing, you agree to our
							<a href="#" class="text-cyan-400 hover:text-cyan-300 hover:underline">Terms of Service</a>
							and
							<a href="#" class="text-cyan-400 hover:text-cyan-300 hover:underline">Privacy Policy</a>
						</p>
					</div>
				</section>
			</div>

			<!-- Back to Home -->
			<div class="mt-8 text-center">
				<a 
					href="/" 
					class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition-colors hover:text-slate-200"
				>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
					</svg>
					Back to home
				</a>
			</div>
		</div>
	</main>
</Layout>

<style>
	/* Add subtle animation to the auth buttons */
	@keyframes shimmer {
		0% {
			background-position: -200% center;
		}
		100% {
			background-position: 200% center;
		}
	}

	button:hover::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.03),
			transparent
		);
		background-size: 200% 100%;
		animation: shimmer 2s infinite;
	}

	button {
		position: relative;
		overflow: hidden;
	}
</style>
