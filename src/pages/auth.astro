---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import TechStackInput from "../components/TechStackInput";
---

<Layout>
	<Navbar transparent={true} minimal={true} />
	
	<main
		class="relative isolate flex min-h-screen w-full items-center justify-center overflow-hidden bg-[#050608] bg-fixed bg-[radial-gradient(circle_at_10%_20%,rgba(76,29,149,0.2),transparent_60%),radial-gradient(circle_at_90%_0%,rgba(6,182,212,0.15),transparent_55%)] text-slate-100"
	>
		<div
			class="pointer-events-none absolute left-1/2 top-[-20vh] -z-10 h-[70vw] w-[70vw] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(14,116,144,0.3)_0%,rgba(14,116,144,0)_60%)] blur-[120px] opacity-50"
			aria-hidden="true"
		></div>

		<div class="mx-auto w-full max-w-md px-5 py-20 sm:max-w-lg sm:px-8 lg:max-w-2xl">
			<div class="items-stretch">
				<section>
					<div class="rounded-2xl border border-slate-800/50 bg-slate-900/40 p-7 backdrop-blur-xl sm:p-8">
						<!-- Header -->
						<div class="mb-6 text-center">
							<div class="mb-3 flex items-center justify-center gap-2.5">
								<span class="h-2.5 w-2.5 rounded-full bg-linear-to-br from-cyan-400 to-pink-500 shadow-[0_0_12px_rgba(236,72,153,0.5)]"></span>
								<span class="text-base font-semibold uppercase tracking-[0.12em] text-slate-100">LockedIn</span>
							</div>
							<h1 id="auth-title" class="mb-1.5 text-xl font-bold text-slate-100 sm:text-2xl">Welcome back</h1>
							<p id="auth-subtitle" class="text-xs text-slate-400">Sign in with your developer account</p>
						</div>

						<!-- Tab Toggle -->
						<div class="mb-5 flex items-center gap-1.5 rounded-lg border border-slate-800/50 bg-slate-950/40 p-1">
							<button
								type="button"
								id="tab-signin"
								class="tab-button flex-1 rounded-md px-3 py-1.5 text-xs font-medium transition-all"
							>
								Sign In
							</button>
							<button
								type="button"
								id="tab-signup"
								class="tab-button flex-1 rounded-md px-3 py-1.5 text-xs font-medium transition-all"
							>
								Create Account
							</button>
						</div>

						<!-- Sign In Form -->
						<div id="form-signin" class="auth-form">
							<div id="signin-error" class="mb-4 hidden rounded-lg border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-[11px] text-rose-300"></div>
							<form class="space-y-3 mb-5">
								<div>
									<label for="signin-username" class="block text-xs font-medium text-slate-400 mb-1">Username</label>
									<input
										type="text"
										id="signin-username"
										placeholder="johndoe"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<div>
									<label for="signin-password" class="block text-xs font-medium text-slate-400 mb-1">Password</label>
									<input
										type="password"
										id="signin-password"
										placeholder="••••••••"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<button
									type="submit"
									class="w-full rounded-lg border border-indigo-500/30 bg-[linear-gradient(in_oklab,to_right,#6EE7F9_0%,#7C3AED_100%)] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
								>
									Sign In
								</button>
							</form>
						</div>

						<!-- Sign Up Form -->
						<div id="form-signup" class="auth-form hidden">
							<div id="signup-error" class="mb-4 hidden rounded-lg border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-[11px] text-rose-300"></div>
							<form class="mb-5 grid grid-cols-1 gap-3 lg:grid-cols-2">
								<div>
									<label for="signup-username" class="block text-xs font-medium text-slate-400 mb-1">Username</label>
									<input
										type="text"
										id="signup-username"
										placeholder="johndoe"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<div>
									<label for="signup-email" class="block text-xs font-medium text-slate-400 mb-1">Email</label>
									<input
										type="email"
										id="signup-email"
										placeholder="john@example.com"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<div class="lg:col-span-2">
									<label for="Github" class="block text-xs font-medium text-slate-400 mb-1">Github/Gitlab/Bitbucket</label>
									<input
										type="text"
										id="signup-github"
										placeholder="https://github.com/username"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<div class="lg:col-span-2">
									<label for="signup-password" class="block text-xs font-medium text-slate-400 mb-1">Password</label>
									<input
										type="password"
										id="signup-password"
										placeholder="••••••••"
										required
										class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
									/>
								</div>
								<div class="lg:col-span-2">
									<label for="signup-bio" class="block text-xs font-medium text-slate-400 mb-1">
										Bio
									</label>
									<div class="relative">
										<textarea
											id="signup-bio"
											placeholder="Tell us about yourself..."
											rows="2"
											maxlength="50"
											class="w-full rounded-lg border border-slate-700/60 bg-slate-900/60 px-3 py-2 pr-12 text-sm text-slate-100 placeholder:text-slate-500 focus:border-slate-600/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 resize-none"
										></textarea>
										<span id="bio-counter" class="absolute right-2 bottom-2 text-[10px] text-slate-500">0/50</span>
									</div>
								</div>
								<div class="relative lg:col-span-2" id="techstack-container">
									<TechStackInput
										client:load
										tags={[]}
										onTagsChange={(tags) => {}}
										maxTags={5}
										placeholder="Type to search tech stack..."
										label="Tech Stack"
									/>
								</div>
								<button
									type="submit"
									class="w-full rounded-lg border border-indigo-500/30 bg-[linear-gradient(in_oklab,to_right,#6EE7F9_0%,#7C3AED_100%)] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 lg:col-span-2"
								>
									Create Account
								</button>
							</form>
						</div>

						<!-- Divider -->
						<div class="mb-4 flex items-center">
							<div class="h-px flex-1 bg-slate-800"></div>
							<span class="px-3 text-[10px] font-medium uppercase tracking-wider text-slate-500">Or continue with</span>
							<div class="h-px flex-1 bg-slate-800"></div>
						</div>

						<!-- Auth Buttons -->
						<div class="grid grid-cols-2 gap-2.5">
							<!-- GitHub Button -->
							<button
								type="button"
								class="group flex items-center justify-center gap-2 rounded-lg border border-slate-700/60 bg-slate-800/40 px-3 py-2 text-xs font-semibold text-slate-100 backdrop-blur-sm transition-all hover:border-slate-600/60 hover:bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github-icon lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
								<span class="hidden sm:inline">GitHub</span>
							</button>

							<!-- GitLab Button -->
							<button
								type="button"
								class="group flex items-center justify-center gap-2 rounded-lg border border-slate-700/60 bg-slate-800/40 px-3 py-2 text-xs font-semibold text-slate-100 backdrop-blur-sm transition-all hover:border-slate-600/60 hover:bg-slate-700/50 focus:outline-none focus:ring-2 focus:ring-pink-500/50"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gitlab-icon lucide-gitlab"><path d="m22 13.29-3.33-10a.42.42 0 0 0-.14-.18.38.38 0 0 0-.22-.11.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18l-2.26 6.67H8.32L6.1 3.26a.42.42 0 0 0-.1-.18.38.38 0 0 0-.26-.08.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18L2 13.29a.74.74 0 0 0 .27.83L12 21l9.69-6.88a.71.71 0 0 0 .31-.83Z"/></svg>
								<span class="hidden sm:inline">GitLab</span>
							</button>
						</div>

						<!-- Divider -->
						<div class="my-4 flex items-center">
							<div class="h-px flex-1 bg-slate-800"></div>
							<span class="px-3 text-[10px] font-medium uppercase tracking-wider text-slate-500">Secure Auth</span>
							<div class="h-px flex-1 bg-slate-800"></div>
						</div>

						<!-- Info -->
						<!-- <div class="space-y-2 rounded-lg border border-slate-800/40 bg-slate-950/40 p-3">
							<div class="flex items-start gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check-icon lucide-shield-check mt-0.5 shrink-0"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
							<div>
								<p class="text-[11px] font-semibold text-slate-200">OAuth 2.0 Protocol</p>
								<p class="text-[10px] leading-snug text-slate-400">We never see your password. Authentication handled securely.</p>
							</div>
							</div>
							<div class="flex items-start gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole-icon lucide-lock-keyhole mt-0.5 shrink-0"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
							<div>
								<p class="text-[11px] font-semibold text-slate-200">Read-Only Access</p>
								<p class="text-[10px] leading-snug text-slate-400">We only request read access to your public profile.</p>
							</div>
							</div>
						</div> -->

						<!-- Footer Note -->
						<p class="mt-4 text-center text-[10px] text-slate-500">
							By continuing, you agree to our
							<a href="#" class="text-cyan-400 hover:text-cyan-300 hover:underline">Terms of Service</a>
							and
							<a href="#" class="text-cyan-400 hover:text-cyan-300 hover:underline">Privacy Policy</a>
						</p>
					</div>
				</section>
			</div>

			<!-- Back to Home -->
			<div class="mt-6 text-center">
				<a 
					href="/" 
					class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 transition-colors hover:text-slate-200"
				>
					<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
					</svg>
					Back to home
				</a>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { api } from '../lib/api';

	function getErrorMessage(error: any): string {
		return (
			error?.response?.data?.message ||
			error?.response?.data?.error ||
			error?.message ||
			'Something went wrong. Please try again.'
		);
	}

	function showError(box: HTMLElement | null, message: string) {
		if (!box) return;
		if (message) {
			box.textContent = message;
			box.classList.remove('hidden');
		} else {
			box.textContent = '';
			box.classList.add('hidden');
		}
	}

	// Tab switching
	const signinTab = document.getElementById('tab-signin');
	const signupTab = document.getElementById('tab-signup');
	const signinForm = document.getElementById('form-signin');
	const signupForm = document.getElementById('form-signup');
	const authTitle = document.getElementById('auth-title');
	const authSubtitle = document.getElementById('auth-subtitle');
	const signinErrorBox = document.getElementById('signin-error');
	const signupErrorBox = document.getElementById('signup-error');

	function setActiveTab(tab: 'signin' | 'signup') {
		if (tab === 'signin') {
			signinTab?.classList.add('bg-slate-800/60', 'text-slate-100');
			signinTab?.classList.remove('text-slate-400');
			signupTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
			signupTab?.classList.add('text-slate-400');
			signinForm?.classList.remove('hidden');
			signupForm?.classList.add('hidden');
			
			// Update header text for sign in
			if (authTitle) authTitle.textContent = 'Welcome back';
			if (authSubtitle) authSubtitle.textContent = 'Sign in with your developer account';
			showError(signinErrorBox, '');
		} else {
			signupTab?.classList.add('bg-slate-800/60', 'text-slate-100');
			signupTab?.classList.remove('text-slate-400');
			signinTab?.classList.remove('bg-slate-800/60', 'text-slate-100');
			signinTab?.classList.add('text-slate-400');
			signupForm?.classList.remove('hidden');
			signinForm?.classList.add('hidden');
			
			// Update header text for sign up
			if (authTitle) authTitle.textContent = 'Join LockedIn';
			if (authSubtitle) authSubtitle.textContent = 'Create your developer account and start building';
			showError(signupErrorBox, '');
		}
	}

	signinTab?.addEventListener('click', () => setActiveTab('signin'));
	signupTab?.addEventListener('click', () => setActiveTab('signup'));

	// Initialize with signin active
	setActiveTab('signin');

	// Bio character counter
	const bioTextarea = document.getElementById('signup-bio') as HTMLTextAreaElement;
	const bioCounter = document.getElementById('bio-counter');

	bioTextarea?.addEventListener('input', () => {
		const length = bioTextarea.value.length;
		if (bioCounter) {
			bioCounter.textContent = `${length}/50`;
			if (length >= 50) {
				bioCounter.classList.add('text-cyan-400');
				bioCounter.classList.remove('text-slate-500');
			} else {
				bioCounter.classList.add('text-slate-500');
				bioCounter.classList.remove('text-cyan-400');
			}
		}
	});

	// Tech stack state management
	let techStackTags: string[] = [];
	
	// Listen for custom events from TechStackInput component
	const techStackContainer = document.getElementById('techstack-container');
	if (techStackContainer) {
		techStackContainer.addEventListener('techstack-change', ((e: CustomEvent) => {
			techStackTags = e.detail.tags;
		}) as EventListener);
	}

	// Sign In Form submission
	document.querySelector('#form-signin form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		
		const submitBtn = (e.target as HTMLFormElement)?.querySelector('button[type="submit"]') as HTMLButtonElement;
		const originalText = submitBtn?.textContent || '';
		
		try {
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Signing in...';
			}

			const username = (document.getElementById('signin-username') as HTMLInputElement)?.value;
			const password = (document.getElementById('signin-password') as HTMLInputElement)?.value;

			console.log('Attempting login with:', { username, password: '***' });

			// Call login API
			const response = await api.login({
				username: username,
				password: password,
			});

			
			showError(signinErrorBox, '');
			// Redirect to feed
			window.location.href = '/';
		} catch (error) {
			console.error('Login failed:', error);
			showError(signinErrorBox, getErrorMessage(error));
			
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = originalText;
			}
		}
	});

	// Sign Up Form submission
	document.querySelector('#form-signup form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		
		const submitBtn = (e.target as HTMLFormElement)?.querySelector('button[type="submit"]') as HTMLButtonElement;
		const originalText = submitBtn?.textContent || '';
		
		try {
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Creating account...';
			}

			const username = (document.getElementById('signup-username') as HTMLInputElement)?.value;
			const email = (document.getElementById('signup-email') as HTMLInputElement)?.value;
			const password = (document.getElementById('signup-password') as HTMLInputElement)?.value;
			const bio = (document.getElementById('signup-bio') as HTMLTextAreaElement)?.value;

			// Call register API
			const response = await api.register({
				username: username,
				email: email,
				password: password,
				bio: bio,
				techStack: techStackTags,
			});
			
			showError(signupErrorBox, '');
			// Redirect to feed
			window.location.href = '/';
		} catch (error: any) {
			console.error('Registration failed:', error);
			showError(signupErrorBox, getErrorMessage(error));
			
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = originalText;
			}
		}
	});
</script>

<style>
	/* Add subtle animation to the auth buttons */
	@keyframes shimmer {
		0% {
			background-position: -200% center;
		}
		100% {
			background-position: 200% center;
		}
	}

	button:hover::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.03),
			transparent
		);
		background-size: 200% 100%;
		animation: shimmer 2s infinite;
	}

	button {
		position: relative;
		overflow: hidden;
	}
</style>
