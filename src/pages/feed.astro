---

<Layout>
	<Navbar page="feed" />

	<main class="relative min-h-screen w-full bg-[#050608] text-slate-100">
		<div class="mx-auto w-full max-w-6xl px-5 pb-24 pt-28 sm:px-8 lg:px-12">
			<header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-3xl font-bold sm:text-4xl">Feed</h1>
					<p class="mt-2 text-slate-400">Stacks of what people are shipping—drag to browse each stack.</p>
				</div>
				<FadeIn client:load>
					<CreatePost client:load compact />
				</FadeIn>
			</header>

			<section class="space-y-10">
				{users.map((u) => (
					<FadeIn client:load>
						<div class="isolate rounded-3xl border border-slate-800/60 bg-slate-900 p-6">
							<ProjectStack client:load user={{ name: u.name, handle: u.handle }} projects={u.projects} />
						</div>
					</FadeIn>
				))}
			</section>
		</div>
	</main>
</Layout>

