			},
			{
				id: "p2",
				title: "Edge Vector Search",
				description: "Cloudflare Workers + HNSW for blazing vector search near users.",
				tags: ["Cloudflare", "HNSW", "TypeScript"],
				status: "building" as const,
				score: 88,
				comments: [],
			},
			{
				id: "p3",
				title: "AI Note Weaving",
				description: "Semantic backlinks that auto-organize notes into living maps.",
				tags: ["LLM", "Embeddings", "UX"],
				status: "live" as const,
				score: 203,
				comments: [],
			},
			{
				id: "p4",
				title: "Offline Notifier",
				description: "Service Worker powered notifications with resilient queues.",
				tags: ["SW", "IndexedDB", "PWA"],
				status: "building" as const,
				score: 47,
				comments: [],
			},
			{
				id: "p5",
				title: "Terminal TUI Toolkit",
				description: "Composable terminal UI components with WebAssembly backends.",
				tags: ["Rust", "WASM", "CLI"],
				status: "live" as const,
				score: 76,
				comments: [],
			},
			{
				id: "p6",
				title: "Realtime Markdown",
				description: "Collaborative markdown editor with CRDT + syntax-aware cursors.",
				tags: ["CRDT", "Monaco", "WebRTC"],
				status: "building" as const,
				score: 129,
				comments: [],
			},
		],
	},
	{
		name: "Sara Malik",
		handle: "saramalik",
		projects: [
			{
				id: "s1",
				title: "Open Source Payroll",
				description: "Self-hosted payroll for indie teams—simple, transparent.",
				tags: ["Go", "Postgres", "Docker"],
					status: "building" as const,
				score: 0,
				comments: [],
			},
			{
				id: "s2",
				title: "3D Scene Editor",
				description: "Browser-native scene editor with procedural assets.",
				tags: ["Three.js", "WebGPU", "Procedural"],
					status: "building" as const,
				score: 150,
				comments: [],
			},
			{
				id: "s3",
				title: "Feature Flag Service",
				description: "Tiny multi-tenant feature flags with SDKs and streaming.",
				tags: ["Node", "Redis", "SSE"],
					status: "live" as const,
				score: 45,
				comments: [],
			},
			{
				id: "s4",
				title: "Design Token Sync",
				description: "Sync design tokens across Figma, CSS, and mobile.",
				tags: ["Figma", "Tokens", "CI"],
					status: "building" as const,
				score: 64,
				comments: [],
