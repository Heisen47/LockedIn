---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatCard from "../components/StatCard.astro";

const stats = [
	{ label: "Active Builders", value: "2.4K" },
	{ label: "Projects Shipped", value: "680" },
	{ label: "Code Hours", value: "12K+" },
];

const features = [
	{
		title: "Showcase Projects",
		description: "Share your work with a community that gets it. Real builders, real feedback.",
	},
	{
		title: "Vote & Discover",
		description: "Upvote the best projects. Let quality rise to the top organically.",
	},
	{
		title: "GitHub Integration",
		description: "One-click auth with GitHub. Your repos, your projects, your story.",
	},
];
---

<Layout>
	<Navbar />
	
	<main
		class="relative isolate min-h-screen w-full overflow-hidden bg-[#050608] bg-fixed bg-[radial-gradient(circle_at_10%_20%,rgba(76,29,149,0.2),transparent_60%),radial-gradient(circle_at_90%_0%,rgba(6,182,212,0.15),transparent_55%)] text-slate-100"
		aria-labelledby="locked-in-heading"
	>
		<div
			class="pointer-events-none absolute left-1/2 top-[-20vh] -z-10 h-[70vw] w-[70vw] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(14,116,144,0.3)_0%,rgba(14,116,144,0)_60%)] blur-[120px] opacity-50"
			aria-hidden="true"
		></div>

		<div class="mx-auto flex w-full max-w-6xl flex-col px-5 pb-20 pt-32 sm:px-8 lg:px-12">
			<!-- Hero Section -->
			<section class="mb-32 flex flex-col items-center text-center">
				<h1 
					class="mb-6 max-w-4xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl" 
					id="locked-in-heading"
				>
					Where builders showcase their craft
				</h1>
				<p class="mb-10 max-w-2xl text-lg text-slate-300 sm:text-xl">
					A social platform for developers. Share projects, get upvoted, build your reputation. GitHub & GitLab auth only.
				</p>
				<div class="flex flex-wrap items-center justify-center gap-4">
					<a
						href="/auth"
						class="inline-flex items-center justify-center rounded-full bg-linear-to-tr from-cyan-400/90 to-pink-500/90 px-8 py-4 text-base font-semibold text-slate-950 transition hover:opacity-90"
					>
						Join with GitHub
					</a>
					<a
						href="#features"
						class="inline-flex items-center justify-center rounded-full border border-slate-700/60 bg-slate-900/40 px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur-sm transition hover:border-slate-600/60 hover:bg-slate-800/40"
					>
						Learn More
					</a>
				</div>

				<!-- Stats -->
				<div class="mt-20 grid w-full max-w-3xl grid-cols-3 gap-4">
					{stats.map((stat) => (
						<StatCard stat={stat} />
					))}
				</div>
			</section>

			<!-- Features Section -->
			<section id="features" class="mb-32">
				<div class="mb-12 text-center">
					<h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">Built for builders</h2>
					<p class="mx-auto max-w-2xl text-slate-400">
						Focus on what matters. Showcase your work, discover great projects, and connect with developers who ship.
					</p>
				</div>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{features.map((feature) => (
						<FeatureCard title={feature.title} description={feature.description} />
					))}
				</div>
			</section>

			<!-- CTA Section -->
			<section id="community" class="mb-20 rounded-3xl border border-slate-800/50 bg-slate-900/30 p-12 text-center backdrop-blur-sm sm:p-16">
				<h2 class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl">
					Ready to ship?
				</h2>
				<p class="mb-8 text-lg text-slate-300">
					Join the community of builders making things happen.
				</p>
				<a
					href="/auth"
					class="inline-flex items-center justify-center rounded-full bg-linear-to-tr from-cyan-400/90 to-pink-500/90 px-8 py-4 text-base font-semibold text-slate-950 transition hover:opacity-90"
				>
					Get Started
				</a>
			</section>

			<!-- Footer -->
			<footer class="border-t border-slate-800/30 pt-10 text-center">
				<div class="mb-6 flex items-center justify-center gap-3">
					<span class="h-2 w-2 rounded-full bg-linear-to-br from-cyan-400 to-pink-500"></span>
					<span class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-200">LockedIn</span>
				</div>
				<p class="mb-6 text-sm text-slate-400">For builders who ship.</p>
				<nav class="flex flex-wrap justify-center gap-6 text-sm text-slate-400" aria-label="Footer">
					<a class="transition-colors hover:text-slate-200" href="#">About</a>
					<a class="transition-colors hover:text-slate-200" href="#">GitHub</a>
					<a class="transition-colors hover:text-slate-200" href="#">Twitter</a>
					<a class="transition-colors hover:text-slate-200" href="#">Discord</a>
				</nav>
			</footer>
		</div>
	</main>
</Layout>
